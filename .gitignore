.DS_Store

# macOS / iCloud conflict copies ("file 2.cpp", "file 3.cpp"). They break the
# build if compiled - PlatformIO globs the filesystem, not the git index.
* [0-9].*

# Same thing without an extension ("LICENSE 2"). The pattern above needs a dot
# after the number, so it missed these and two of them reached a branch.
* [0-9]
